<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">
    <View
        android:id="@+id/tutorialBackgroundDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_radial_gradient"
        android:alpha="0" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tutorialContainer"
        android:layout_width="416dp"
        android:layout_height="326dp"
        android:background="@drawable/container"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/numberPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/alata_regular"
            android:gravity="center"
            android:text="@string/labeltutorialcount"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/tutorialImage"
            android:layout_width="230dp"
            android:layout_height="147dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/tutorial1"
            app:layout_constraintBottom_toTopOf="@+id/btnClose"
            app:layout_constraintEnd_toStartOf="@+id/rightArrow"
            app:layout_constraintStart_toEndOf="@+id/leftArrow" />

        <TextView
            android:id="@+id/Credits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/alata_regular"
            android:includeFontPadding="false"
            android:text="@string/labeltutorialtitle"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tutorialLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/alata_regular"
            android:gravity="center"
            android:text="@string/labeltutorialdesc"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.501"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/Credits" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnClose"
            android:layout_width="136dp"
            android:layout_height="37dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/closeLabel"
                android:layout_width="81dp"
                android:layout_height="36dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/alata_regular"
                android:gravity="center_horizontal"
                android:text="@string/labelClose"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:fontFamily="@font/alata_regular"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/leftArrow"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/tutorialImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tutorialImage"
            app:srcCompat="@drawable/back_arrow" />

        <ImageView
            android:id="@+id/rightArrow"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:layout_marginEnd="16dp"
            android:rotation="-180"
            app:layout_constraintBottom_toBottomOf="@+id/tutorialImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tutorialImage"
            app:srcCompat="@drawable/back_arrow" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>