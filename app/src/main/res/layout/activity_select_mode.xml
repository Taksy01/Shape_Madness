<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".SelectModeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bg1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/IVbackbtn"
            android:layout_width="56dp"
            android:layout_height="50dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/back_arrow" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/frame1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerMode"
                android:layout_width="180dp"
                android:layout_height="319dp"
                android:layout_marginStart="55dp"
                android:background="@drawable/container"
                android:elevation="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/containerMode2"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alata_regular"
                    android:text="@string/labelmode"
                    android:textColor="#FFFFFF"
                    android:textSize="48sp"
                    app:fontFamily="@font/alata_regular"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/normalBtn"
                    android:layout_width="136dp"
                    android:layout_height="37dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/premium_button"
                    android:elevation="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView2">

                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="129dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginBottom="3dp"
                        android:fontFamily="@font/alata_regular"
                        android:text="@string/labelnormal"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        app:fontFamily="@font/alata_regular"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sandboxBtn"
                    android:layout_width="136dp"
                    android:layout_height="37dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/button"
                    android:elevation="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/normalBtn">

                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="129dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginBottom="3dp"
                        android:fontFamily="@font/alata_regular"
                        android:text="@string/labelsandbox"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        app:fontFamily="@font/alata_regular"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerMode2"
                android:layout_width="250dp"
                android:layout_height="319dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="55dp"
                android:background="@drawable/container"
                android:elevation="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/containerMode"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/modeImg"
                    android:layout_width="227dp"
                    android:layout_height="291dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.521"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/normal_img" />

                <TextView
                    android:id="@+id/WaveLabel"
                    android:layout_width="186dp"
                    android:layout_height="25dp"
                    android:layout_marginBottom="4dp"
                    android:alpha="0.5"
                    android:fontFamily="@font/alata_regular"
                    android:gravity="center"
                    android:text="@string/labelhighscore"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:fontFamily="@font/alata_regular"
                    app:layout_constraintBottom_toTopOf="@+id/btnClose"
                    app:layout_constraintEnd_toEndOf="@+id/btnClose"
                    app:layout_constraintStart_toStartOf="@+id/btnClose" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btnClose"
                    android:layout_width="136dp"
                    android:layout_height="37dp"
                    android:layout_marginTop="260dp"
                    android:background="@drawable/button"
                    android:elevation="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">



                    <TextView
                        android:id="@+id/playLabel"
                        android:layout_width="58dp"
                        android:layout_height="38dp"
                        android:layout_marginBottom="3dp"
                        android:fontFamily="@font/alata_regular"
                        android:gravity="center_horizontal"
                        android:text="@string/labelmodeplay"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        app:fontFamily="@font/alata_regular"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/selectedMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/alata_regular"
                    android:text="@string/labelmodeindicator"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:fontFamily="@font/alata_regular"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>