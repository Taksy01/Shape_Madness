<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">
    <View
        android:id="@+id/settingsBackgroundDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_radial_gradient"
        android:alpha="0" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/CreditsContainer"
        android:layout_width="416dp"
        android:layout_height="326dp"
        android:background="@drawable/container"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/Credits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/alata_regular"
            android:text="@string/labelsettings"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tutorialLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/alata_regular"
            android:text="@string/labelsettingsinvert"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.305"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/Credits" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchInvert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:background="@null"
            android:checked="false"
            android:thumb="@drawable/custom_switch_thumb"
            app:layout_constraintBottom_toBottomOf="@+id/tutorialLabel"
            app:layout_constraintStart_toEndOf="@+id/tutorialLabel"
            app:layout_constraintTop_toTopOf="@+id/tutorialLabel"
            app:thumbTint="@null"
            app:track="@drawable/custom_switch_track"
            app:trackTint="@null" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnClose"
            android:layout_width="136dp"
            android:layout_height="37dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/button"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/closeLabel"
                android:layout_width="81dp"
                android:layout_height="36dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/alata_regular"
                android:gravity="center_horizontal"
                android:text="@string/labelClose"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:fontFamily="@font/alata_regular"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>