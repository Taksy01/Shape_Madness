<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainGameActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bg1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" >

            <ImageView
                android:id="@+id/tutorial"
                android:layout_width="289dp"
                android:layout_height="138dp"
                android:layout_marginBottom="32dp"
                android:src="@drawable/tutorial"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/pause_button"
            android:layout_width="63dp"
            android:layout_height="37dp"
            android:layout_marginTop="8dp"
            android:elevation="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/pause_button" />

        <ImageView
            android:id="@+id/IVcanon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="32dp"
            android:elevation="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.08"
            app:layout_constraintDimensionRatio="1:1.1"
            app:srcCompat="@drawable/canon1" />

        <ImageView
            android:id="@+id/playerHealthBar"
            android:layout_width="234dp"
            android:layout_height="28dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:elevation="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/player_healthbar" />

        <ImageView
            android:id="@+id/playerHealthBarFill"
            android:layout_width="212dp"
            android:layout_height="18dp"
            android:elevation="31dp"
            app:layout_constraintBottom_toBottomOf="@+id/playerHealthBar"
            app:layout_constraintEnd_toEndOf="@+id/playerHealthBar"
            app:layout_constraintStart_toStartOf="@+id/playerHealthBar"
            app:layout_constraintTop_toTopOf="@+id/playerHealthBar"
            app:srcCompat="@drawable/player_healthbar_fill" />

        <ImageView
            android:id="@+id/playerHealthBarHearth"
            android:layout_width="39dp"
            android:layout_height="34dp"
            android:layout_marginEnd="-16dp"
            android:elevation="32dp"
            app:layout_constraintBottom_toBottomOf="@+id/playerHealthBarFill"
            app:layout_constraintEnd_toStartOf="@+id/playerHealthBarFill"
            app:layout_constraintTop_toTopOf="@+id/playerHealthBarFill"
            app:srcCompat="@drawable/player_healthbar_hearth" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerMode"
            android:layout_width="133dp"
            android:layout_height="43dp"
            android:layout_marginStart="-10dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/transparent_container"
            android:elevation="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/playerHealthBarHearth">

            <ImageView
                android:id="@+id/DiamondCurrency"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/diamond" />

            <TextView
                android:id="@+id/DiamondLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/alata_regular"
                android:text="0"
                android:textColor="#D7D7D7"
                android:textColorLink="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/DiamondCurrency"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/waveIndicatorLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/alata_regular"
            android:text="WAVE 1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:alpha="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/containerMode" />
        <View
            android:id="@+id/damageFlash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF0000"
            android:alpha="0"
            android:elevation="1000dp" />

        <TextView
            android:id="@+id/waveText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="20dp"
            android:fontFamily="@font/alata_regular"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="8"
            android:shadowDy="8"
            android:shadowRadius="15"
            android:text="WAVE 1"
            android:textColor="#FFFFFF"
            android:textSize="90sp"
            android:textStyle="bold|italic"
            android:visibility="invisible"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/upgradeMenu"
            layout="@layout/layout_upgrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="35dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <include layout="@layout/layout_class" />
</androidx.constraintlayout.widget.ConstraintLayout>